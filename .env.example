# AgentFence Gateway Configuration
AGENTFENCE_AUTH_TOKEN=agentfence-dev-token
AGENTFENCE_HOST=127.0.0.1
AGENTFENCE_PORT=8000

# Optional: Live LLM Planner Provider API Keys
# AgentFence runs with zero-configuration deterministic fallback when offline or without keys.
# Set either key below to connect live model providers for the run_agent CLI.
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
